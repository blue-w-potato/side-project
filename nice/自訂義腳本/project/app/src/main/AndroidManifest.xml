<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 懸浮視窗權限(Q25:與無障礙服務一起在啟動流程第一步請求) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".ScriptAutoApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.ScriptAuto">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 無障礙服務(ADR-0001) -->
        <service
            android:name=".accessibility.AutomationAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 懸浮視窗服務(Q9:全系統同時只允許一個實例存在) -->
        <service
            android:name=".service.FloatingControlService"
            android:exported="false" />

    </application>
</manifest>
